    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "@vercel/og": "^0.6.8",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
