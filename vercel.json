{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/pull/:c/:f",
      "destination": "/api/pull?c=:c&f=:f"
    },
    {
      "source": "/run",
      "destination": "/api/run"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/form.ts": {
      "maxDuration": 300
    },
    "api/pull.ts": {
      "includeFiles": "node_modules/{@vercel/og/package.json,@vercel/og/dist/**,@expo-google-fonts/lilita-one/400Regular/LilitaOne_400Regular.ttf,@expo-google-fonts/barlow-condensed/800ExtraBold/BarlowCondensed_800ExtraBold.ttf,@expo-google-fonts/barlow/600SemiBold/Barlow_600SemiBold.ttf}"
    },
    "api/account.ts": {
      "includeFiles": "node_modules/jose/{package.json,dist/webapi/**}"
    },
    "api/run.ts": {
      "includeFiles": "node_modules/{@vercel/og/package.json,@vercel/og/dist/**,@expo-google-fonts/lilita-one/400Regular/LilitaOne_400Regular.ttf,@expo-google-fonts/barlow-condensed/800ExtraBold/BarlowCondensed_800ExtraBold.ttf,@expo-google-fonts/barlow/600SemiBold/Barlow_600SemiBold.ttf}"
    }
  },
  "crons": [
    {
      "path": "/api/form?refresh=1",
      "schedule": "17 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
